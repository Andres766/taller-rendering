# ── Fuente del catálogo de películas ──────────────────────────────────────────
# auto   → TMDB si hay TMDB_API_TOKEN; si no, iTunes Store (real y sin clave).
# tmdb | itunes | demo → fuerza una fuente (demo = catálogo ficticio, sin red).
CATALOG_SOURCE=auto
# País de la cartelera/tienda (ISO 3166-1) e idioma de los textos.
CATALOG_REGION=CO
CATALOG_LANGUAGE=es-CO

# Opcional: "API Read Access Token" gratuito de https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# ── Revalidación ISR bajo demanda ─────────────────────────────────────────────
# Secreto para POST /api/revalidate. Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se deja vacío, el endpoint rechaza todas las solicitudes (401).
REVALIDATE_SECRET=
